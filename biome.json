{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 200 },
  "javascript": { "formatter": { "quoteStyle": "single", "arrowParentheses": "asNeeded" } },
  "html": { "formatter": { "enabled": false } },
  "css": { "formatter": { "enabled": false } },
  "linter": {
    "rules": {
      "a11y": {
        "useButtonType": "off",
        "useHeadingContent": "off",
        "useValidAnchor": "off"
      },
      "complexity": { "noImportantStyles": "off" },
      "style": { "noDescendingSpecificity": "off" }
    }
  }
}
